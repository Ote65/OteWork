{
  "name": "dsh-session-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Expose one DeepSeek Harness session to another Agent (Codex, Trae, …) over the authenticated /api channel: a discovery document, the transcript, live status, and a one-click copyable handoff prompt from the sidebar.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mcp",
    "session",
    "bridge",
    "handoff"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}

{
  "name": "dsh-element-picker",
  "version": "0.1.0",
  "private": true,
  "description": "Element reference for the built-in browser preview: arm it, click a UI element in the preview, and a precise reference lands in the composer so the Agent can locate the exact source.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "browser",
    "preview",
    "element-picker",
    "inspector"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}
